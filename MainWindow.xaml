<Window x:Class="KrishnaTypingMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Krishna's Typing Master Pro" Height="620" Width="950"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    
    <!-- मुख्य पृष्ठभूमि (HTML Background Gradient) -->
    <Border CornerRadius="12" Margin="20">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#d3d8fa" Offset="0.0" />
                <GradientStop Color="#b3bcfa" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        
        <!-- ऐप विंडो (App Window) -->
        <Border CornerRadius="12" Background="#7a63df" Margin="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" Opacity="0.4" Direction="270" ShadowDepth="15"/>
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <!-- कंटेंट एरिया (Content Area Gradient) -->
                <Border Grid.Column="0" CornerRadius="12,0,0,12" Padding="25">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#eaf9c4" Offset="0.0" />
                            <GradientStop Color="#cceb87" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <!-- 1. लॉगिन व्यू (Login View) -->
                        <Grid x:Name="LoginView" Visibility="Visible">
                            <Border Background="#99FFFFFF" BorderBrush="#b5d56c" BorderThickness="2" 
                                    CornerRadius="15" Padding="40" Width="500" Height="250"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="𝕶𝖗𝖎𝖘𝖍𝖓𝖆'𝖘 𝕿𝖞𝖕𝖎𝖓𝖌 𝕸𝖆𝖘𝖙𝖊𝖗 𝕻𝖗𝖔" FontSize="32" FontWeight="Bold" Foreground="#5b45a0" Margin="0,0,0,20"/>
                                    <TextBlock Text="Welcome! Please enter your name" FontSize="16" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBox x:Name="UsernameBox" Width="300" Height="40" FontSize="16" Padding="5" Margin="0,0,0,20"/>
                                    <Button Content="Enter" Width="150" Height="40" Background="#5b45a0" Foreground="White" FontSize="16" Click="Login_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="15"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 2. लाइव टाइपिंग व्यू (Live Typing View) -->
                        <Grid x:Name="LiveTypingView" Visibility="Hidden">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock x:Name="LiveSpeedText" Text="Live Speed: 0 WPM" FontSize="14" FontWeight="Bold" Foreground="#5b45a0" HorizontalAlignment="Right" Margin="0,0,10,10"/>
                            
                            <Border Grid.Row="1" Background="#f1f9e3" BorderBrush="#a4c952" BorderThickness="2" CornerRadius="8" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <RichTextBox x:Name="RefTextBox" Background="Transparent" BorderThickness="0" FontSize="18" IsReadOnly="True">
                                        <FlowDocument>
                                            <Paragraph x:Name="RefTextParagraph" LineHeight="30"/>
                                        </FlowDocument>
                                    </RichTextBox>
                                    
                                    <Border Grid.Row="1" BorderBrush="#b8d28c" BorderThickness="0,2,0,0" Margin="0,10,0,0"/>
                                    
                                    <TextBox x:Name="UserInputBox" Grid.Row="2" Background="White" BorderBrush="#ccc" BorderThickness="1" 
                                             FontSize="18" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="UserInputBox_TextChanged">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- साइडबार (Sidebar) -->
                <Grid Grid.Column="1" Margin="0,40,0,0">
                    <StackPanel x:Name="SidebarTabs" Visibility="Hidden">
                        <Button Content="📚 Studying" Style="{DynamicResource TabButtonStyle}"/>
                        <Button Content="📝 Typing Test" Style="{DynamicResource TabButtonStyle}" Background="#cbe986" Foreground="Black"/>
                        <Button Content="🎮 Games" Style="{DynamicResource TabButtonStyle}"/>
                        <Button Content="📊 Statistics" Style="{DynamicResource TabButtonStyle}"/>
                    </StackPanel>

                    <!-- साइडबार टाइमर (Sidebar Timer) -->
                    <StackPanel x:Name="TestControls" Visibility="Hidden" HorizontalAlignment="Center">
                        <TextBlock Text="Time" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TimerDisplay" Text="00:00" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button Content="Close X" Foreground="White" Background="Transparent" BorderThickness="0" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-30,10,0" Click="Close_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Border>

    <Window.Resources>
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#d1ccf5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="10,0,0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20,0,0,20">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>

